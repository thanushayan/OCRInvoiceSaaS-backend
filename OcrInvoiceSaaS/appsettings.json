{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=OcrInvoiceSaaS;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "OcrInvoiceSaaS",
    "Audience": "OcrInvoiceSaaS",
    "ExpiryHours": "1",
    "RefreshTokenDays": "30"
  },
  "Security": {
    "Lockout": {
      "MaxFailedAttempts": "5",
      "LockoutMinutes": "15",
      "WindowMinutes": "10"
    },
    "TwoFactor": {
      "OtpExpiryMinutes": "10",
      "SessionExpiryMinutes": "10"
    },
    "PasswordReset": {
      "ExpiryMinutes": "60"
    }
  },
  "App": {
    "BaseUrl": "https://app.ocrinvoicesaas.com"
  },
  "SendGrid": {
    "ApiKey": "REPLACE_WITH_SENDGRID_API_KEY",
    "FromEmail": "noreply@ocrinvoicesaas.com",
    "FromName": "OCR Invoice SaaS"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Currency": {
    "Provider": "OpenExchangeRates",
    "OpenExchangeRatesAppId": "REPLACE_WITH_YOUR_APP_ID",
    "BaseCurrency": "GBP",
    "CacheHours": "4"
  },
  "RateLimit": {
    "Starter": "500",
    "Growth": "2000",
    "Enterprise": "10000"
  },
  "Webhooks": {
    "MaxEndpointsPerCompany": "10",
    "DeliveryTimeoutSeconds": "10",
    "MaxRetryAttempts": "5"
  },
  "Email": {
    "Provider": "Console",
    "_comment": "Set to SendGrid or Mailgun for production"
  },
  "Mailgun": {
    "ApiKey": "REPLACE_WITH_MAILGUN_API_KEY",
    "Domain": "REPLACE_WITH_YOUR_DOMAIN",
    "From": "noreply@yourdomain.com",
    "Region": "EU"
  },
  "CompaniesHouse": {
    "ApiKey": "REPLACE_WITH_COMPANIES_HOUSE_API_KEY"
  },
  "Hmrc": {
    "BearerToken": "REPLACE_WITH_HMRC_BEARER_TOKEN"
  },
  "Xero": {
    "ClientId": "REPLACE_WITH_XERO_CLIENT_ID",
    "ClientSecret": "REPLACE_WITH_XERO_CLIENT_SECRET",
    "RedirectUri": "https://app.ocrinvoicesaas.com/api/companies/{id}/integrations/xero/callback"
  },
  "Stripe": {
    "WebhookSecret": "REPLACE_WITH_STRIPE_WEBHOOK_SECRET"
  }
}